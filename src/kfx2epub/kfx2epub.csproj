<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>kfx2epub</AssemblyName>
    <RootNamespace>Kfx2Epub</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Styles\*.css" LogicalName="Styles.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 以官方 zlib 原始碼 + /MT 建置；與 Python zlib 產生相同位元流。 -->
    <None Update="native\zlib1.dll" TargetPath="zlib1.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="native\zlib-LICENSE.txt" TargetPath="zlib-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
